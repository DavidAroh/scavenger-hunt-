# --- Public URL used inside the QR codes (no trailing slash) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Admin (/admin). REQUIRED in production. ---
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase (required to open registration and persist tester data) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Explicit local-only switch. Leave false for tester runs; tester data must use Supabase.
RIL_DEMO_MODE=false
